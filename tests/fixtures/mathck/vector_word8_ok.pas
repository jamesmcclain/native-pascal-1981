{ VECTOR [4] OF WORD8: boundary lanes that fit, for + - * DIV MOD,
  one operation per group of four WRITELNs (WORD8 range 0..255).
  .out holds the exact results, which are the same under either
  setting; the suite prepends the MATHCK+ or MATHCK- directive. }
PROGRAM VectorMath;
TYPE V = VECTOR [4] OF WORD8;
VAR a, b, c: V; t, s: WORD8;
BEGIN
t := 254;
a[0] := t;
t := 0;
a[1] := t;
t := 1;
a[2] := t;
t := 2;
a[3] := t;
t := 1;
b[0] := t;
t := 0;
b[1] := t;
t := 254;
b[2] := t;
t := 3;
b[3] := t;
c := a + b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := 255;
a[0] := t;
t := 1;
a[1] := t;
t := 9;
a[2] := t;
t := 255;
a[3] := t;
t := 255;
b[0] := t;
t := 0;
b[1] := t;
t := 4;
b[2] := t;
t := 1;
b[3] := t;
c := a - b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := 255;
a[0] := t;
t := 1;
a[1] := t;
t := 2;
a[2] := t;
t := 0;
a[3] := t;
t := 1;
b[0] := t;
t := 255;
b[1] := t;
t := 127;
b[2] := t;
t := 255;
b[3] := t;
c := a * b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := 255;
a[0] := t;
t := 9;
a[1] := t;
t := 0;
a[2] := t;
t := 255;
a[3] := t;
t := 1;
b[0] := t;
t := 2;
b[1] := t;
t := 7;
b[2] := t;
t := 255;
b[3] := t;
c := a DIV b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := 255;
a[0] := t;
t := 9;
a[1] := t;
t := 0;
a[2] := t;
t := 255;
a[3] := t;
t := 2;
b[0] := t;
t := 4;
b[1] := t;
t := 7;
b[2] := t;
t := 255;
b[3] := t;
c := a MOD b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
END.
