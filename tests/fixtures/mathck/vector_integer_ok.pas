{ VECTOR [4] OF INTEGER: boundary lanes that fit, for + - * DIV MOD and negation,
  one operation per group of four WRITELNs (INTEGER range -32768..32767).
  .out holds the exact results, which are the same under either
  setting; the suite prepends the MATHCK+ or MATHCK- directive. }
PROGRAM VectorMath;
TYPE V = VECTOR [4] OF INTEGER;
VAR a, b, c: V; t, s: INTEGER;
BEGIN
t := -32768;
a[0] := t;
t := 32767;
a[1] := t;
t := -1;
a[2] := t;
t := -32767;
a[3] := t;
t := 0;
b[0] := t;
t := 0;
b[1] := t;
t := 1;
b[2] := t;
t := 32767;
b[3] := t;
c := a + b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := -32767;
a[0] := t;
t := -1;
a[1] := t;
t := 32767;
a[2] := t;
t := 0;
a[3] := t;
t := 1;
b[0] := t;
t := 32767;
b[1] := t;
t := 32767;
b[2] := t;
t := 32767;
b[3] := t;
c := a - b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := -16384;
a[0] := t;
t := -1;
a[1] := t;
t := 32767;
a[2] := t;
t := -32768;
a[3] := t;
t := 2;
b[0] := t;
t := 32767;
b[1] := t;
t := -1;
b[2] := t;
t := 1;
b[3] := t;
c := a * b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := -32768;
a[0] := t;
t := -7;
a[1] := t;
t := 7;
a[2] := t;
t := 32767;
a[3] := t;
t := 1;
b[0] := t;
t := 2;
b[1] := t;
t := -2;
b[2] := t;
t := -1;
b[3] := t;
c := a DIV b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := -32768;
a[0] := t;
t := -7;
a[1] := t;
t := 7;
a[2] := t;
t := 32767;
a[3] := t;
t := 3;
b[0] := t;
t := 2;
b[1] := t;
t := -2;
b[2] := t;
t := -1;
b[3] := t;
c := a MOD b;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
t := 32767;
a[0] := t;
t := 0;
a[1] := t;
t := -32767;
a[2] := t;
t := -32767;
a[3] := t;
c := -a;
WRITELN(c[0]);
WRITELN(c[1]);
WRITELN(c[2]);
WRITELN(c[3]);
END.
