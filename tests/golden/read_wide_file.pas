{ DIALECT: extended }
PROGRAM ReadWideFile(output);
VAR f: TEXT; a: INTEGER32; b: INTEGER64;
BEGIN
  REWRITE(f);
  WRITELN(f, ' 70000 5000000000');
  WRITELN(f, '-2147483648 -9223372036854775808');
  WRITELN(f, '2147483647 9223372036854775807');
  RESET(f);
  READ(f, a, b);
  WRITELN(a); WRITELN(b);
  READLN(f);
  READLN(f, a, b);
  WRITELN(a); WRITELN(b);
  READLN(f, a, b);
  WRITELN(a); WRITELN(b);
  CLOSE(f)
END.
