{ CHECK-INPUT: tests/reference/codegen/device_kernel_attrs/kh.ast.json }
{ CHECK-ENV: PASCAL_DEVICE_TRIPLE=nvptx64-nvidia-cuda }
{ CHECK-ANY: define ptx_kernel void @scale(ptr addrspace(1) nocapture readonly align 4 dereferenceable(1024) %0, ptr addrspace(1) align 4 dereferenceable(1024) %1 || define ptx_kernel void @scale(ptr addrspace(1) readonly align 4 captures(none) dereferenceable(1024) %0, ptr addrspace(1) align 4 dereferenceable(1024) %1 }
{ CHECK-ANY: define ptx_kernel void @via_helper(ptr addrspace(1) nocapture readonly align 4 dereferenceable(1024) %0, ptr addrspace(1) nocapture readonly align 4 dereferenceable(1024) %1 || define ptx_kernel void @via_helper(ptr addrspace(1) readonly align 4 captures(none) dereferenceable(1024) %0, ptr addrspace(1) readonly align 4 captures(none) dereferenceable(1024) %1 }
{ CHECK: define ptx_kernel void @via_writer(ptr addrspace(1) align 4 dereferenceable(1024) %0 }
{ CHECK-NOT: noalias }
