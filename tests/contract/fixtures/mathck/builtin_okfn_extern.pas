PROGRAM OkFuncs;
VAR s: INTEGER; w: WORD;
FUNCTION UADDOK(A, B: WORD; VAR C: WORD): BOOLEAN; EXTERN;
FUNCTION SADDOK(A, B: INTEGER; VAR C: INTEGER): BOOLEAN; EXTERN;
FUNCTION UMULOK(A, B: WORD; VAR C: WORD): BOOLEAN; EXTERN;
FUNCTION SMULOK(A, B: INTEGER; VAR C: INTEGER): BOOLEAN; EXTERN;
BEGIN
  WRITELN(SADDOK(1, 2, s), ' ', s);
  WRITELN(SADDOK(32767, 1, s), ' ', s);
  WRITELN(SADDOK(32767, 0, s), ' ', s);
  WRITELN(SADDOK(-32768, -1, s), ' ', s);
  WRITELN(SADDOK(-32768, 32767, s), ' ', s);
  WRITELN(SADDOK(-1, -1, s), ' ', s);
  WRITELN(SADDOK(181, 181, s), ' ', s);
  WRITELN(SADDOK(182, 182, s), ' ', s);
  WRITELN(SADDOK(-32768, -32768, s), ' ', s);
  WRITELN(SADDOK(-32768, 1, s), ' ', s);
  WRITELN(SADDOK(255, -129, s), ' ', s);
  WRITELN(SADDOK(0, -32768, s), ' ', s);
  WRITELN(SMULOK(1, 2, s), ' ', s);
  WRITELN(SMULOK(32767, 1, s), ' ', s);
  WRITELN(SMULOK(32767, 0, s), ' ', s);
  WRITELN(SMULOK(-32768, -1, s), ' ', s);
  WRITELN(SMULOK(-32768, 32767, s), ' ', s);
  WRITELN(SMULOK(-1, -1, s), ' ', s);
  WRITELN(SMULOK(181, 181, s), ' ', s);
  WRITELN(SMULOK(182, 182, s), ' ', s);
  WRITELN(SMULOK(-32768, -32768, s), ' ', s);
  WRITELN(SMULOK(-32768, 1, s), ' ', s);
  WRITELN(SMULOK(255, -129, s), ' ', s);
  WRITELN(SMULOK(0, -32768, s), ' ', s);
  WRITELN(UADDOK(1, 2, w), ' ', w);
  WRITELN(UADDOK(65535, 1, w), ' ', w);
  WRITELN(UADDOK(65535, 0, w), ' ', w);
  WRITELN(UADDOK(32768, 32768, w), ' ', w);
  WRITELN(UADDOK(255, 257, w), ' ', w);
  WRITELN(UADDOK(256, 256, w), ' ', w);
  WRITELN(UADDOK(65535, 65535, w), ' ', w);
  WRITELN(UADDOK(0, 65535, w), ' ', w);
  WRITELN(UADDOK(40000, 2, w), ' ', w);
  WRITELN(UMULOK(1, 2, w), ' ', w);
  WRITELN(UMULOK(65535, 1, w), ' ', w);
  WRITELN(UMULOK(65535, 0, w), ' ', w);
  WRITELN(UMULOK(32768, 32768, w), ' ', w);
  WRITELN(UMULOK(255, 257, w), ' ', w);
  WRITELN(UMULOK(256, 256, w), ' ', w);
  WRITELN(UMULOK(65535, 65535, w), ' ', w);
  WRITELN(UMULOK(0, 65535, w), ' ', w);
  WRITELN(UMULOK(40000, 2, w), ' ', w);
END.
