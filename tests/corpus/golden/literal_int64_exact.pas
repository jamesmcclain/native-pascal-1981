{ DIALECT: extended }
{ Integer literals of more than 15 digits are exact. The stages pass the
  AST as JSON, whose numbers cJSON prints with 15 significant digits, so
  these once compiled wrong: 9223372036854775805 as 9223372036854775807,
  9007199254740993 and 9007199254740992 as 9007199254740990. }
PROGRAM LiteralInt64Exact(output);
CONST NEAR = 9223372036854775805; ODDBIG = -9007199254740993;
VAR q: INTEGER64; u: WORD64;
BEGIN
  q := 9223372036854775805; WRITELN(q);
  q := 1234567890123456789; WRITELN(q);
  q := 9007199254740993; WRITELN(q);
  q := -9007199254740993; WRITELN(q);
  q := -9223372036854775805; WRITELN(q);
  WRITELN(NEAR, ' ', ODDBIG, ' ', NEAR - 9223372036854775804);
  WRITELN(1234567890123456789 + 1, ' ', 9007199254740993 - 9007199254740992);
  q := 9007199254740992;
  WRITELN(q = 9007199254740993, ' ', q < 9007199254740993, ' ', q + 1 = 9007199254740993);
  u := 9223372036854775001; WRITELN(u);
  u := 1; WRITELN(u + 9007199254740993);
  { 16 digits, below 2^53: still more than cJSON's 15. }
  WRITELN(1234567890123456, ' ', 9007199254740992, ' ', -1000000000000001)
END.
