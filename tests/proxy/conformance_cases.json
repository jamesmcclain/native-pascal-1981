{
  "cases": [
    {
      "name": "complete_ok",
      "request_hex": "",
      "note": "The baseline request. Also captures the outgoing upstream payload, which pins the request shape: two messages, top-level reasoning_effort, and no \"stop\" field.",
      "capture_upstream": true
    },
    {
      "name": "complete_no_goal",
      "request_hex": "",
      "note": "An empty goal must not emit a \"{  }\" comment line before the prefix.",
      "capture_upstream": false
    },
    {
      "name": "complete_multiline_goal",
      "request_hex": "",
      "note": "A goal is flattened to one line: newlines become spaces so the goal stays a single Pascal comment.",
      "capture_upstream": false
    },
    {
      "name": "complete_fenced",
      "request_hex": "",
      "note": "A markdown fence anywhere in the reply is unwrapped, and prose before it is dropped rather than landing in the buffer.",
      "capture_upstream": false
    },
    {
      "name": "complete_parts",
      "request_hex": "",
      "note": "message.content may be a list of {type,text} parts, not just a string.",
      "capture_upstream": false
    },
    {
      "name": "complete_empty",
      "request_hex": "",
      "note": "A whitespace-only completion yields \"completions\": [], never [\"\"].",
      "capture_upstream": false
    },
    {
      "name": "complete_controls",
      "request_hex": "",
      "note": "C0 controls and DEL are stripped; \\t and \\n survive.",
      "capture_upstream": false
    },
    {
      "name": "complete_special_token",
      "request_hex": "",
      "note": "Everything from the first \"<|\" marker onward is discarded.",
      "capture_upstream": false
    },
    {
      "name": "complete_many_lines",
      "request_hex": "",
      "note": "An 80-line completion is truncated to --max-lines (30).",
      "capture_upstream": false
    },
    {
      "name": "complete_many_chars",
      "request_hex": "",
      "note": "A 9000-character single line is truncated to 8192 characters.",
      "capture_upstream": false
    },
    {
      "name": "strip_echo_exact",
      "request_hex": "",
      "note": "strip_echo pass 1: the reply restates the buffer tail verbatim, an overlap well over the 5-character floor, so the overlap is removed.",
      "capture_upstream": false
    },
    {
      "name": "strip_echo_short_overlap_kept",
      "request_hex": "",
      "note": "A short overlap is structurally required repetition, not an echo. Two nested blocks legitimately close back to back; stripping \"END;\" here was a real bug once, so a <= 5 character overlap must be preserved.",
      "capture_upstream": false
    },
    {
      "name": "strip_echo_partial_identifier",
      "request_hex": "",
      "note": "strip_echo pass 2: the buffer stops mid-identifier (\"DISPO\") and the reply opens with the whole word, so only the typed prefix is removed.",
      "capture_upstream": false
    },
    {
      "name": "cursor_clamped_beyond_end",
      "request_hex": "",
      "note": "A cursor past the end of the buffer is clamped, not rejected: it is a normal race between typing and requesting, not a client error.",
      "capture_upstream": false
    },
    {
      "name": "cursor_first_position",
      "request_hex": "",
      "note": "A cursor at the very start yields an empty prefix.",
      "capture_upstream": false
    },
    {
      "name": "upstream_no_choices",
      "request_hex": "",
      "note": "Upstream returning an empty choices list must surface as a clean 502, never a stack trace or a 200 with junk in it.",
      "capture_upstream": false
    },
    {
      "name": "upstream_not_an_object",
      "request_hex": "",
      "note": "Upstream returning a JSON array where an object was expected must surface as a clean 502, never a stack trace or a 200 with junk in it.",
      "capture_upstream": false
    },
    {
      "name": "upstream_null_content",
      "request_hex": "",
      "note": "Upstream returning a null message.content must surface as a clean 502, never a stack trace or a 200 with junk in it.",
      "capture_upstream": false
    },
    {
      "name": "upstream_http_500",
      "request_hex": "",
      "note": "Upstream returning a non-200 status from the backend must surface as a clean 502, never a stack trace or a 200 with junk in it.",
      "capture_upstream": false
    },
    {
      "name": "upstream_malformed",
      "request_hex": "",
      "note": "Upstream returning a body that is not JSON at all must surface as a clean 502, never a stack trace or a 200 with junk in it.",
      "capture_upstream": false
    },
    {
      "name": "upstream_reasoning_exhausted",
      "request_hex": "",
      "note": "finish_reason \"length\" with empty content but non-empty reasoning_content is an error, not an empty completion. This is what makes --reasoning-effort auto calibration able to tell \"this effort value never answers\" from \"the backend is down\".",
      "capture_upstream": false
    },
    {
      "name": "upstream_timeout",
      "request_hex": "",
      "note": "The backend stalls past --upstream-timeout, so the proxy gives up first and reports it, rather than leaving the editor to time out with no explanation.",
      "capture_upstream": false
    },
    {
      "name": "health_ok",
      "request_hex": "474554202f6865616c746820485454502f312e310d0a486f73743a203132372e302e302e310d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a",
      "note": "GET /health performs a live probe and reports the resolved model and reasoning_effort.",
      "capture_upstream": false
    },
    {
      "name": "unknown_get_path",
      "request_hex": "474554202f6e6f706520485454502f312e310d0a486f73743a203132372e302e302e310d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a",
      "note": "Any GET that is not /health is a 404.",
      "capture_upstream": false
    },
    {
      "name": "unknown_post_path",
      "request_hex": "",
      "note": "Any POST that is not /complete is a 404.",
      "capture_upstream": false
    },
    {
      "name": "get_on_complete",
      "request_hex": "474554202f636f6d706c65746520485454502f312e310d0a486f73743a203132372e302e302e310d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a",
      "note": "GET /complete is a 404, not a 405: the GET handler only knows /health.",
      "capture_upstream": false
    },
    {
      "name": "empty_body",
      "request_hex": "504f5354202f636f6d706c65746520485454502f312e310d0a486f73743a203132372e302e302e310d0a436f6e74656e742d547970653a206170706c69636174696f6e2f6a736f6e0d0a436f6e74656e742d4c656e6774683a20300d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a",
