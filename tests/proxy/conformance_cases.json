    },
    {
      "name": "truncated_body",
      "request_hex": "504f5354202f636f6d706c65746520485454502f312e310d0a486f73743a203132372e302e302e310d0a436f6e74656e742d547970653a206170706c69636174696f6e2f6a736f6e0d0a436f6e74656e742d4c656e6774683a203230300d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a7b22676f616c223a227822",
